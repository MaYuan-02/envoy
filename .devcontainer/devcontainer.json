{
  "name": "Envoy Dev (Stable)",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "workspaceFolder": "/build",

  "mounts": [
    "source=${localWorkspaceFolder},target=/build,type=bind"
  ],

  "remoteUser": "envoybuild",
  "updateRemoteUserUID": true,

  "remoteEnv": {
    "HOME": "/home/envoybuild",
    "VSCODE_AGENT_FOLDER": "/home/envoybuild/.vscode-server",
    "ENVOY_SRCDIR": "/build",

    "HTTPS_PROXY": "${env:VSCODE_CONTAINER_HTTPS_PROXY}",
    "HTTP_PROXY": "${env:VSCODE_CONTAINER_HTTP_PROXY}",
    "NO_PROXY": "${env:VSCODE_CONTAINER_NO_PROXY}"
  },

  "capAdd": [
    "SYS_PTRACE",
    "NET_RAW",
    "NET_ADMIN"
  ],

  "securityOpt": [
    "seccomp=unconfined"
  ],

  "initializeCommand": ".devcontainer/init.sh",
  "postCreateCommand": ".devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",

        "bazel.buildifierFixOnFormat": true,

        "clangd.path": "${workspaceFolder}/.devcontainer/clangd-wrapper.sh",
        "clangd.arguments": [
          "--query-driver=**"
        ],

        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.formatting.provider": "yapf",
        "python.formatting.yapfArgs": [
          "--style=${workspaceFolder}/.style.yapf"
        ],

        "files.exclude": {
          "**/.clangd/**": true,
          "**/bazel-*/**": true
        },
        "files.watcherExclude": {
          "**/.clangd/**": true,
          "**/bazel-*/**": true
        }
      },

      "extensions": [
        "github.vscode-pull-request-github",
        "zxh404.vscode-proto3",
        "bazelbuild.vscode-bazel",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "webfreak.debug",
        "ms-python.python"
      ]
    }
  }
}